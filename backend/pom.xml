<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.com.chfb.ativo</groupId>
    <artifactId>ativos-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ativos-backend</name>
    <description>Sistema de gestão de ativos e investimentos (monólito modular)</description>

    <modules>
        <module>shared-kernel</module>
        <module>asset-management</module>
        <module>market-tracker</module>
        <module>predictive-engine</module>
        <module>core-api</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Só o core-api é executável; os demais módulos são ignorados pelo spring-boot:run. -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
        <!-- A linha 2.8 é a compatível com o Spring Boot 3.5. -->
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.com.chfb.ativo</groupId>
                <artifactId>shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.chfb.ativo</groupId>
                <artifactId>asset-management</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.chfb.ativo</groupId>
                <artifactId>market-tracker</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.chfb.ativo</groupId>
                <artifactId>predictive-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
